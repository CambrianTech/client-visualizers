  "scripts": {
    "start": "concurrently \"cd server; npm run server\" \"react-scripts start\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "cd server; npm run start;",
    "postinstall": "cd server; node -e \"process.env.NODE_ENV != 'production' && process.exit(1)\" || npm install",
    "sync": "mkdir -p cambrianar-sites; cd public; ln -sfn ../cambrianar-sites cambrianar-sites; aws s3 cp s3://cambrianar-sites/$npm_package_config_default_site cambrianar-sites/$npm_package_config_default_site --recursive"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "aggregate-error": "^3.1.0",
    "concurrently": "^5.3.0",
    "source-map-loader": "^2.0.1",
    "typescript": "^4.1.5",
    "webpack-cli": "^4.5.0"
  }
